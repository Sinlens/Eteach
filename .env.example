# Copy to .env and fill in. Never commit .env (manual §28).

# Which data implementations run: "mock" (browser storage, no infrastructure)
# or "supabase". Anything else falls back to "mock".
# VITE_-prefixed because the browser decides which adapter to build.
VITE_DATA_BACKEND=mock

# Server-only. Required when VITE_DATA_BACKEND=supabase.
#
# The service role key bypasses row level security by design - every table has
# RLS enabled with no policies, so this is currently the only way in. It must
# never be exposed to the browser or prefixed with VITE_.
#
# On Cloudflare these are Worker secrets, not build-time variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for the n8n / AI phase. Not read yet.
# N8N_TRANSLATE_WEBHOOK=
# N8N_PHRASES_WEBHOOK=
# OPENROUTER_API_KEY=
